{
  "description": "Debian Linux 13: Trixie core image provided by KASM.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "debian_linux.svg",
  "run_config": {
    "hostname": "trixie-core"
  },
  "exec_config": {
    "first_launch": {
      "user": "root",
      "cmd": "bash -c 'echo \"kasm-user  ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers'"
    }
  },
  "categories": [
    "Development"
  ],
  "friendly_name": "Core Trixie",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "kasmweb/core-debian-trixie:1.18.0",
      "cores": 2,
      "memory": 2048,
      "uncompressed_size_mb": 1100,
      "available_tags": [
        "1.18.0",
        "1.18.0-rolling-daily",
        "1.18.0-rolling-weekly"
      ]
    }
  ]
}
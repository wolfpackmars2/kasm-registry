{
  "description": "Ubuntu 24.04: Noble core Docker-in-Docker image with upgrades and patches.",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "ubuntu_dind.png",
  "run_config": {
    "hostname": "noble-dind"
  },
  "exec_config": {
    "first_launch": {
      "user": "root",
      "cmd": "bash -c 'echo \"kasm-user  ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers'"
    }
  },
  "categories": [
    "Development"
  ],
  "friendly_name": "Noble DinD",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "kasmweb/core-ubuntu-noble:1.18.0",
      "cores": 4,
      "memory": 4096,
      "uncompressed_size_mb": 1700,
      "available_tags": [
        "1.18.0-current"
      ]
    }
  ]
}